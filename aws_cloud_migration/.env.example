# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012

# S3 Configuration
S3_BUCKET_NAME=bioinformatics-pipeline
S3_RAW_PREFIX=raw/counts/
S3_PROCESSED_PREFIX=processed/normalized/
S3_RESULTS_PREFIX=results/de_genes/

# AWS Glue Configuration
GLUE_DATABASE_NAME=rnaseq_db
GLUE_TABLE_NAME=raw_counts
GLUE_JOB_NAME=rnaseq-etl-pipeline
COUNT_THRESHOLD=10

# AWS EMR Configuration
EMR_CLUSTER_NAME=bioinformatics-deseq2-cluster
EMR_INSTANCE_TYPE=r5.xlarge
EMR_CORE_INSTANCE_COUNT=3

# AWS Lambda Configuration
LAMBDA_MEMORY_SIZE=512
LAMBDA_TIMEOUT=300
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:bioinformatics-data-quality
MAX_MISSING_PERCENT=10.0
MIN_SAMPLE_COUNT=3
REQUIRED_COLUMNS=gene_id,gene_name

# ECS Configuration
ECS_CLUSTER_NAME=bioinformatics-cluster
ECS_TASK_FAMILY=bioinformatics-rnaseq-analysis
ECR_REPOSITORY_URI=123456789012.dkr.ecr.us-east-1.amazonaws.com/bioinformatics-rnaseq

# Email Notifications
SNS_EMAIL=data-team@example.com

# Environment
ENVIRONMENT=production
LOG_LEVEL=INFO
