# Terraform configuration for AWS streaming infrastructure

terraform {
  required_version = ">= 1.0"
  
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

provider "aws" {
  region = var.aws_region
}

variable "aws_region" {
  description = "AWS region"
  type        = string
  default     = "us-east-1"
}

variable "project_name" {
  description = "Project name"
  type        = string
  default     = "healthcare-streaming"
}

# Placeholder resources for streaming infrastructure
output "project_name" {
  value       = var.project_name
  description = "Project name"
}
